# Copy this file to .env and fill in real values for live runs.
# DO NOT commit .env to version control.

# OpenAI-compatible LLM (defaults to Groq via LLM_BASE_URL)
# Leave empty for offline runs and tests; set a real key only for live provider tests.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0

# Default region for phone-number parsing when no country code is provided
DEFAULT_PHONE_REGION=DE

# Logging
LOG_LEVEL=INFO

# Voice interface (all disabled by default for local development/tests)
VOICE_ENABLED=false
VOICE_STT_ENABLED=false
VOICE_TTS_ENABLED=false
# VOICE_MAX_AUDIO_BYTES=1048576
# VOICE_MAX_AUDIO_SECONDS=60
# VOICE_SUPPORTED_INPUT_TYPES=audio/wav,audio/webm
# VOICE_OUTPUT_CONTENT_TYPE=audio/wav
# VOICE_STT_MODEL=whisper-1
# VOICE_TTS_MODEL=tts-1
# VOICE_TTS_VOICE=alloy
